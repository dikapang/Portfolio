---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, projects, capabilities, about, funFacts } from '../config';

const hasContact = Boolean(site.email || site.links.length);
const heroName = site.name || 'Portfolio';
const heroLead = site.tagline || (site.role ? `${site.role}.` : '');
const primaryChannel = site.email ? `mailto:${site.email}` : site.links[0]?.href;
const acronym = (title: string): string =>
  title.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<Layout>
  {/* Pembuka: wordmark + garis isi, lalu tirai naik. CSS murni, tetap aman tanpa JS */}
  <div class="loader" aria-hidden="true">
    <p class="loader-word">Dika Pangestu</p>
    <span class="loader-line"></span>
  </div>

  {/* Lanskap senja: wrapper pin ala parallax — scene sticky 100dvh di dalam
      wrapper 320dvh; scroll menggerakkan progress (matahari naik, lapisan
      bergeser), nama menumpang di atas scene dan memudar di paruh akhir */}
  <div class="scene-wrap" data-scene>
    <div class="bg-field" id="hero-field" aria-hidden="true"></div>

    {/* 01 · Hero: nama di atas lanskap */}
    <section class="hero">
      <div class="container intro-block" data-hero>
      {site.status && (
        <div class="hero-status" role="status">
          <span class="pulse"></span>
          {site.status}
        </div>
      )}
      <h1 class="display">{heroName}</h1>
      <p class="lead">{heroLead}</p>
      {(projects.length > 0 || primaryChannel) && (
        <div class="actions">
          {projects.length > 0 && (
            <a class="btn btn-default btn-lg" href="#work">
              Lihat pekerjaan
              <Icon name="arrow-right" />
            </a>
          )}
          {primaryChannel && (
            <a class="btn btn-outline btn-lg" href={primaryChannel}>
              {site.email ? 'Hubungi saya' : site.links[0].label}
              {site.email && <Icon name="arrow-up-right" />}
            </a>
          )}
        </div>
      )}
    </div>

    {projects.length > 1 && (
      <div class="container index-foot" data-plx="22">
        <nav class="proj-index" aria-label="Proyek">
          {projects.slice(0, 4).map((p, i) => (
            <a href={`#proj-${i + 1}`}>
              <span>{p.title}</span>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            </a>
          ))}
        </nav>
      </div>
    )}
  </section>

  {/* 02 · Chapter Profil: mengisi layar kedua fase pin, masuk dari kanan */}
  {about.length > 0 && (
    <section class="scene-chapter" id="about">
      <div class="container">
        <div class="about-glass" data-plx-x="46">
          <div class="about-main">
            <h2 class="h2">Profil saya</h2>
            <p class="about-statement">{about[0]}</p>
            {about.length > 1 && (
              <div class="about-prose">
                {about.slice(1).map((para) => <p class="p muted">{para}</p>)}
              </div>
            )}
          </div>
          <aside class="about-side">
            {(site.location || site.email || capabilities.length > 0) && (
              <dl class="about-facts" data-stagger>
                {site.location && (
                  <div>
                    <dt>Lokasi</dt>
                    <dd>{site.location}</dd>
                  </div>
                )}
                {capabilities.length > 0 && (
                  <div>
                    <dt>Fokus</dt>
                    <dd>{capabilities.slice(0, 2).map((c) => c.title.toLowerCase()).join(', ')}</dd>
                  </div>
                )}
                {site.email && (
                  <div>
                    <dt>Kontak</dt>
                    <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
                  </div>
                )}
              </dl>
            )}
            {funFacts.length > 0 && (
              <div class="fun-block">
                <p class="label">Di luar kode</p>
                <div class="badges">
                  {funFacts.map((f) => <span class="badge badge-outline">{f}</span>)}
                </div>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>
  )}
  </div>

  {/* 03 · Pekerjaan terpilih */}
  {projects.length > 0 && (
    <section class="section" id="work">
      <div class="container">
        <div class="section-head" data-reveal data-plx-x="-38">
          <h2 class="h2">Pekerjaan terpilih</h2>
        </div>
        <div class="work-grid" data-stagger>
          {projects.map((p, i) => {
            const CardBody = (
              <>
                {p.image ? (
                  <div class="work-media" data-plx-x={i % 2 ? "-56" : "56"}>
                    <img src={p.image} alt={`Tangkapan layar proyek ${p.title}`} loading="lazy" />
                  </div>
                ) : (
                  <div class="work-cover" data-viz="cover" data-plx-x={i % 2 ? "-56" : "56"}>
                    <span class="cover-mark">{acronym(p.title)}</span>
                    {p.year && <span class="cover-year mono">{p.year}</span>}
                  </div>
                )}
                <div class="work-body">
                  <h3 class="h3 work-title">{p.title}</h3>
                  <p class="muted p work-summary">{p.summary}</p>
                  {(p.kind || (p.badges && p.badges.length)) && (
                    <div class="badges">
                      {p.kind && <span class="badge badge-brand">{p.kind}</span>}
                      {p.badges?.map((b) => <span class="badge badge-outline">{b}</span>)}
                    </div>
                  )}
                  {p.metrics && p.metrics.length > 0 && (
                    <dl class="metrics">
                      {p.metrics.map((m) => (
                        <div>
                          <dt>{m.label}</dt>
                          <dd>{m.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {p.href && (
                    <span class="link-arrow">
                      Baca detail
                      <Icon name="arrow-right" />
                    </span>
                  )}
                </div>
              </>
            );
            return p.href
              ? <a class="card work-card" id={`proj-${i + 1}`} href={p.href}>{CardBody}</a>
              : <article class="card work-card" id={`proj-${i + 1}`}>{CardBody}</article>;
          })}
        </div>
      </div>
    </section>
  )}

  {/* 03 · Yang saya kerjakan */}
  {capabilities.length > 0 && (
    <section class="section" id="services">
      <div class="container">
        <div class="section-head" data-reveal data-plx-x="38">
          <h2 class="h2">Yang saya kerjakan</h2>
        </div>
        <div class="cap-grid" data-stagger>
          {capabilities.map((c, i) => (
            <article class="card cap-card">
              {c.viz && <div class="cap-visual grid-bg" data-viz={c.viz} data-plx-x={i % 2 ? "-46" : "46"}></div>}
              <div class="cap-body">
                <h3 class="h3">{c.title}</h3>
                <p class="muted p">{c.description}</p>
                {c.tools && c.tools.length > 0 && (
                  <div class="badges">
                    {c.tools.map((t) => <span class="badge badge-secondary">{t}</span>)}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* 04 · Kontak */}
  {hasContact && (
    <section class="section" id="contact">
      <div class="container">
        <div class="cta" data-plx-x="42">
          <h2 class="h2">Mari bekerja sama.</h2>
          <p class="lead">Ceritakan proyek Anda. Balasan secepatnya lewat kanal di bawah.</p>
          <div class="actions">
            {site.email && (
              <a class="btn btn-inverse btn-lg" href={`mailto:${site.email}`}>
                <Icon name="mail" />
                {site.email}
              </a>
            )}
            {site.links.filter((l) => l.href !== primaryChannel).map((l) => (
              <a class="btn btn-inverse btn-lg" href={l.href} target="_blank" rel="noopener">{l.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Hero — dot-field di belakang, konten di tengah layar pertama */
  .hero {
    position: absolute; top: 0; left: 0; right: 0; height: calc(100dvh - 4rem); isolation: isolate;
    display: flex; flex-direction: column;
    padding-top: clamp(2rem, 6vh, 5rem);
  }
  /* Pembuka: tirai wordmark yang terangkat setelah garis terisi */
  .loader {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-content: center; justify-items: center; gap: 1.25rem;
    background: var(--background); pointer-events: none;
    animation: loader-up .75s var(--ease-out) 1.15s forwards;
  }
  .loader-word {
    font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 600; letter-spacing: -.02em;
    color: var(--foreground); opacity: 0;
    animation: loader-in .6s var(--ease-out) .1s forwards;
  }
  .loader-line { position: relative; width: min(16rem, 44vw); height: 1.5px; background: var(--border); overflow: hidden; }
  .loader-line::after {
    content: ""; position: absolute; inset: 0; background: var(--brand);
    transform: scaleX(0); transform-origin: left;
    animation: loader-fill .85s var(--ease-out) .22s forwards;
  }
  @keyframes loader-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes loader-fill { to { transform: scaleX(1); } }
  @keyframes loader-up { to { transform: translateY(-100%); visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .loader { display: none; } }

  /* Chapter di dalam fase pin: layar kedua diisi panel Profil */
  .scene-chapter {
    position: absolute; top: calc(100dvh - 4rem); left: 0; right: 0;
    height: calc(100dvh - 4rem);
    display: grid; align-items: center;
  }

  /* Wrapper pin ala parallax: scene sticky setinggi viewport di bawah header */
  .scene-wrap { position: relative; height: 240dvh; }
  .bg-field {
    position: sticky; top: 4rem; height: calc(100dvh - 4rem); overflow: clip;
    z-index: -2; pointer-events: none;
  }
  .bg-field canvas { width: 100% !important; height: 100% !important; }
  .intro-block {
    display: flex; flex-direction: column; align-items: flex-start; gap: 1.75rem; text-align: left;
    margin-block: auto 8vh; margin-inline: 0; width: 100%; max-width: none;
    padding-inline: max(1.5rem, calc((100vw - 1200px) / 2 + 1.25rem));
  }
  .hero-status {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .25rem .875rem;
    border: 1px solid var(--border); border-radius: 999px;
    background: color-mix(in oklch, var(--background) 70%, transparent);
    font-size: .8125rem; color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .hero-status .pulse {
    width: 7px; height: 7px; border-radius: 999px; background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--success) 22%, transparent);
  }
  .hero .display { max-width: 13em; font-size: clamp(3.25rem, 8vw, 6.5rem); text-wrap: balance; }
  .hero .lead { max-width: 38rem; font-size: 1.1875rem; }

  /* Strip indeks proyek di kaki hero — baris tautan bergaris rambut */
  .index-foot { padding-top: 2.5rem; padding-bottom: 1.25rem; }
  .proj-index {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: .25rem 1.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
  .proj-index a {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .25rem 0; white-space: nowrap;
    font-size: .875rem; font-weight: 500; color: var(--muted-foreground);
    transition: color .15s;
  }
  .proj-index a:hover { color: var(--foreground); }
  .proj-index .idx { font-family: var(--font-mono); font-size: .75rem; color: var(--muted-foreground); }

  /* Pekerjaan */
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .work-grid > :last-child:nth-child(odd) { grid-column: 1 / -1; }
  .work-card { gap: 1.25rem; padding: 1.5rem 0; overflow: hidden; transition: transform .3s var(--ease-out), border-color .2s, box-shadow .3s; }
  a.work-card:hover { transform: translateY(-5px); border-color: color-mix(in oklch, var(--foreground) 24%, transparent); box-shadow: var(--shadow-md); }
  .work-media { border: 1px solid var(--border); border-radius: var(--radius-lg); aspect-ratio: 16 / 9; overflow: hidden; }
  .work-media img { width: 100%; height: 100%; object-fit: cover; }
  .work-cover {
    position: relative;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    aspect-ratio: 16 / 7;
    display: grid; place-items: center;
    overflow: hidden;
    padding: 1.25rem 1rem;
    background: color-mix(in oklch, var(--muted) 30%, var(--card));
  }
  .work-cover canvas { position: absolute; inset: 0; }
  .cover-mark {
    position: relative;
    font-size: clamp(2.5rem, 4.5vw, 3.5rem); font-weight: 600;
    letter-spacing: -.04em; line-height: 1;
    color: color-mix(in oklch, var(--foreground) 88%, transparent);
    transition: color .2s;
  }
  a.card:hover .cover-mark { color: var(--brand-text); }
  .cover-year {
    position: absolute; left: 1rem; bottom: .75rem;
    font-size: .75rem; color: var(--muted-foreground);
  }
  .work-body { display: flex; flex-direction: column; align-items: flex-start; gap: .875rem; padding: 0 1.5rem; }
  .work-title { letter-spacing: -.025em; }
  .work-summary { font-size: .9375rem; }
  .badges { display: flex; flex-wrap: wrap; gap: .375rem; }
  .metrics {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px;
    width: 100%; border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--border); overflow: hidden;
  }
  .metrics > div { padding: .875rem 1rem; background: var(--card); }
  .metrics dt { font-size: .75rem; color: var(--muted-foreground); }
  .metrics dd { margin-top: .25rem; font-size: 1.5rem; font-weight: 600; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }

  /* Kapabilitas — kartu dengan sketsa canvas */
  .cap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .cap-card { padding: 0; overflow: hidden; }
  .cap-visual { position: relative; aspect-ratio: 16 / 7; border-bottom: 1px solid var(--border); }
  .cap-visual canvas { position: absolute; inset: 0; }
  .cap-body { display: flex; flex-direction: column; gap: .75rem; padding: 1.5rem; }

  /* Profil saya — panel kaca di atas lanskap stuck */
  .about { padding-top: clamp(6rem, 12vh, 7.5rem); }
  .about-glass {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1.5rem, 4.5vw, 3.75rem);
    border: 1px solid var(--border); border-radius: var(--radius-2xl);
    background: color-mix(in oklch, var(--background) 58%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.25);
    backdrop-filter: blur(16px) saturate(1.25);
    box-shadow: var(--shadow-lg);
  }
  .about-main { display: grid; gap: 1.5rem; align-content: start; }
  .about-statement {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 500; line-height: 1.3; letter-spacing: -.025em;
    max-width: 28ch; text-wrap: balance;
  }
  .about-prose { display: grid; gap: 1.25rem; max-width: 62ch; }
  .about-side { display: grid; gap: 1.5rem; align-content: start; }
  .about-facts {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1px;
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    background: var(--border); overflow: hidden;
  }
  .about-facts > div { display: grid; gap: .375rem; padding: 1rem 1.25rem; background: color-mix(in oklch, var(--card) 72%, transparent); }
  .about-facts dt { font-size: .8125rem; color: var(--muted-foreground); }
  .about-facts dd { font-weight: 500; font-size: .875rem; overflow-wrap: anywhere; }
  .about-facts a { transition: color .15s; }
  .about-facts a:hover { color: var(--brand-text); }
  .fun-block { display: flex; flex-direction: column; gap: .75rem; padding-top: .25rem; }
  .fun-block .badges { gap: .5rem; }
  @media (max-width: 899px) {
    .about-glass { grid-template-columns: minmax(0, 1fr); }
  }

  /* CTA — panel invers dengan pola grid */
  .cta {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;
    padding: clamp(2.5rem, 6vw, 5rem);
    border-radius: var(--radius-2xl);
    background: var(--primary); color: var(--primary-foreground);
  }
  .cta::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background-image: radial-gradient(color-mix(in oklch, var(--primary-foreground) 16%, transparent) 1.2px, transparent 1.4px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(to top left, var(--mask-ink), transparent 62%);
    mask-image: linear-gradient(to top left, var(--mask-ink), transparent 62%);
  }
  .cta .h2 { max-width: 14ch; }
  .cta .lead { max-width: 36rem; color: color-mix(in oklch, var(--primary-foreground) 74%, var(--primary)); }

  @media (max-width: 899px) {
    .work-grid { grid-template-columns: minmax(0, 1fr); }
    .work-grid > :last-child:nth-child(odd) { grid-column: auto; }
    .cap-grid { grid-template-columns: minmax(0, 1fr); }
    .about-facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import '../scripts/field3d';
  import '../scripts/cursor';
  import '../scripts/viz';
</script>
